import csv
import os
import xml.etree.ElementTree as ET
from tkinter import Tk, filedialog, messagebox, ttk


def parse_archicad_xml(xml_path):
    """Parses the Archicad XML file using a structurally flexible approach."""
    try:
        tree = ET.parse(xml_path)
        root = tree.getroot()
    except Exception as e:
        raise ValueError(f"Error parsing XML file: {e}")

    layers_by_guid = {}  # guid -> Layer Name
    all_layers = set()
    combinations = {}    # ComboName -> { LayerName: "Present"/"Not Present" }

    # 1. STEP: Extract all Layers (Look inside any Attributes block, flexible check)
    # Usually under <Attributes Type="Lucidi"> or similar, but we search for the <Layer> tags directly.
    for layer_node in root.findall(".//Layer"):
        # We ensure it's a definition layer (has an Index and Name, but NOT inside a combination status)
        if layer_node.get("Idx") is not None and layer_node.find("Name") is not None:
            layer_name = layer_node.findtext("Name")
            if not layer_name:
                continue
            
            guid_node = layer_node.find(".//OdbRef/guid")
            guid = guid_node.text if guid_node is not None else None
            
            # Check default layer status from flags
            flags_text = layer_node.findtext("Flags") or ""
            is_default_hidden = "Layer_Hidden" in flags_text
            
            all_layers.add(layer_name)
            if guid:
                layers_by_guid[guid] = {
                    "name": layer_name,
                    "default_status": "Not Present" if is_default_hidden else "Present"
                }

    # 2. STEP: Extract Layer Combinations (Search globally for <LayerCombination>)
    for combo_node in root.findall(".//LayerCombination"):
        combo_name = combo_node.findtext("Name")
        if not combo_name:
            continue
        
        combinations[combo_name] = {}
        
        # Inside LayerCombination, Archicad stores statuses inside <LayerStatus> blocks
        for layer_status_node in combo_node.findall(".//LayerStatus"):
            # Find the layer GUID reference
            layer_ref_guid_node = layer_status_node.find(".//Layer/OdbRef/guid")
            if layer_ref_guid_node is None:
                continue
            
            ref_guid = layer_ref_guid_node.text
            
            # Check the status node (it usually contains visibility flags/numbers)
            status_node = layer_status_node.find("Status")
            status_text = status_node.text if status_node is not None else ""
            
            # In Archicad XML, if a layer is hidden in a combo, it contains 'Hidden' or specific bitmasks
            is_hidden = (
                "Hidden" in status_text or 
                status_text == "0" or 
                ("0x" in status_text and status_text.endswith("0"))
            )
            
            if ref_guid in layers_by_guid:
                l_name = layers_by_guid[ref_guid]["name"]
                combinations[combo_name][l_name] = "Not Present" if is_hidden else "Present"

    return sorted(list(all_layers)), combinations, layers_by_guid


def generate_matrix(xml_path, csv_path):
    """Generates the cross-tabulated matrix and saves it as a CSV file."""
    sorted_layers, combinations, layers_by_guid = parse_archicad_xml(xml_path)

    if not sorted_layers:
        raise ValueError("Could not find any layers in the XML file. Please check the structure.")

    sorted_combos = sorted(list(combinations.keys()))
    
    # CRITICAL CHECK: If no combinations were extracted, raise an informative error
    if not sorted_combos:
        raise ValueError("No layer combinations found in the XML. Make sure to export BOTH layers and combinations from Archicad.")

    header = ["Layers / Combinations"] + sorted_combos

    with open(csv_path, mode="w", newline="", encoding="utf-8-sig") as f:
        writer = csv.writer(f, delimiter=";")
        writer.writerow(header)

        for layer in sorted_layers:
            row = [layer]
            
            # Find global default fallback for this layer
            fallback = "Present"
            for g_info in layers_by_guid.values():
                if g_info["name"] == layer:
                    fallback = g_info["default_status"]
                    break

            for combo in sorted_combos:
                # Get status from combo, if missing, use the layer's default fallback status
                status = combinations[combo].get(layer, fallback)
                row.append(status)
            writer.writerow(row)


class ArchicadConverterApp:
    """Tkinter Graphical User Interface."""
    def __init__(self, root):
        self.root = root
        self.root.title("Archicad XML to CSV Converter")
        self.root.geometry("500x200")
        self.root.resizable(False, False)

        self.xml_file = ""

        frame = ttk.Frame(root, padding="20")
        frame.pack(fill="both", expand=True)

        self.lbl_info = ttk.Label(
            frame,
            text="Select the XML file exported from Archicad to generate the Layer/Combination matrix.",
            wraplength=450,
        )
        self.lbl_info.pack(pady=10)

        self.btn_select = ttk.Button(
            frame, text="Select XML File", command=self.select_file
        )
        self.btn_select.pack(pady=10)

        self.lbl_status = ttk.Label(
            frame, text="No file selected", foreground="gray"
        )
        self.lbl_status.pack(pady=5)

    def select_file(self):
        self.xml_file = filedialog.askopenfilename(
            title="Open Archicad XML", filetypes=[("XML Files", "*.xml")]
        )

        if self.xml_file:
            self.lbl_status.config(text=os.path.basename(self.xml_file), foreground="black")
            csv_file = filedialog.asksaveasfilename(
                title="Save CSV as...",
                defaultextension=".csv",
                filetypes=[("CSV Files", "*.csv")],
                initialfile="Archicad_Layer_Matrix.csv",
            )

            if csv_file:
                try:
                    generate_matrix(self.xml_file, csv_file)
                    messagebox.showinfo("Success", "CSV file generated successfully!")
                except Exception as e:
                    messagebox.showerror("Error", f"An error occurred:\n{str(e)}")
            else:
                self.lbl_status.config(text="Saving cancelled", foreground="orange")
        else:
            self.lbl_status.config(text="No file selected", foreground="gray")


if __name__ == "__main__":
    root = Tk()
    app = ArchicadConverterApp(root)
    root.mainloop()
